{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "domsanitize",
  "version": "1.0.2",
  "description": "Declarative schema-based HTML attribute validation. Define which tags, attributes, and values are allowed and enforce them.",
  "keywords": [
    "allowlist",
    "attributes",
    "conformance",
    "dom",
    "dom-schema",
    "html",
    "html-schema",
    "policy",
    "schema",
    "validation"
  ],
  "homepage": "https://github.com/RampantDespair/domsanitize#readme",
  "bugs": {
    "url": "https://github.com/RampantDespair/domsanitize/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RampantDespair/domsanitize.git"
  },
  "license": "MIT",
  "author": "RampantDespair",
  "type": "commonjs",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/browser.d.mts",
          "default": "./dist/browser.mjs"
        },
        "require": {
          "types": "./dist/browser.d.cts",
          "default": "./dist/browser.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./defaults": {
      "import": {
        "types": "./dist/defaults.d.mts",
        "default": "./dist/defaults.mjs"
      },
      "require": {
        "types": "./dist/defaults.d.cts",
        "default": "./dist/defaults.cjs"
      }
    },
    "./defaults/attributes/globals": {
      "import": {
        "types": "./dist/lib/default/attributes/globals.d.mts",
        "default": "./dist/lib/default/attributes/globals.mjs"
      },
      "require": {
        "types": "./dist/lib/default/attributes/globals.d.cts",
        "default": "./dist/lib/default/attributes/globals.cjs"
      }
    },
    "./defaults/attributes/others": {
      "import": {
        "types": "./dist/lib/default/attributes/others.d.mts",
        "default": "./dist/lib/default/attributes/others.mjs"
      },
      "require": {
        "types": "./dist/lib/default/attributes/others.d.cts",
        "default": "./dist/lib/default/attributes/others.cjs"
      }
    },
    "./defaults/attributes/shared": {
      "import": {
        "types": "./dist/lib/default/attributes/shared.d.mts",
        "default": "./dist/lib/default/attributes/shared.mjs"
      },
      "require": {
        "types": "./dist/lib/default/attributes/shared.d.cts",
        "default": "./dist/lib/default/attributes/shared.cjs"
      }
    },
    "./defaults/primitives": {
      "import": {
        "types": "./dist/lib/default/primitives.d.mts",
        "default": "./dist/lib/default/primitives.mjs"
      },
      "require": {
        "types": "./dist/lib/default/primitives.d.cts",
        "default": "./dist/lib/default/primitives.cjs"
      }
    },
    "./defaults/regexes": {
      "import": {
        "types": "./dist/lib/default/regexes.d.mts",
        "default": "./dist/lib/default/regexes.mjs"
      },
      "require": {
        "types": "./dist/lib/default/regexes.d.cts",
        "default": "./dist/lib/default/regexes.cjs"
      }
    },
    "./defaults/tags": {
      "import": {
        "types": "./dist/lib/default/tags.d.mts",
        "default": "./dist/lib/default/tags.mjs"
      },
      "require": {
        "types": "./dist/lib/default/tags.d.cts",
        "default": "./dist/lib/default/tags.cjs"
      }
    },
    "./utils/url": {
      "import": {
        "types": "./dist/lib/utils/url.d.mts",
        "default": "./dist/lib/utils/url.mjs"
      },
      "require": {
        "types": "./dist/lib/utils/url.d.cts",
        "default": "./dist/lib/utils/url.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "jsdom": "^31.0.1",
    "parse5": "^8.1.1",
    "parse5-htmlparser2-tree-adapter": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^3.5.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "rimraf": "^6.1.4",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "type-fest": "^6.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.11.1": true
  }
}
